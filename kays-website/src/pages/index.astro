---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- ══════════════════════════════════════════════════════
       NAVIGATION
  ══════════════════════════════════════════════════════ -->
  <nav
    id="navbar"
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
    style="background: transparent;"
  >
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12 h-[68px] flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <svg width="36" height="36" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="64" height="64" rx="10" fill="#1a6eff" fill-opacity="0.12"/>
          <polygon points="32,8 56,28 32,56 8,28" fill="none" stroke="#1a6eff" stroke-width="2.5"/>
          <polygon points="32,8 56,28 32,24 8,28" fill="#1a6eff" fill-opacity="0.35"/>
          <line x1="8" y1="28" x2="56" y2="28" stroke="#1a6eff" stroke-width="1.5" stroke-opacity="0.7"/>
        </svg>
        <div class="leading-none">
          <div class="text-base font-800 tracking-[0.12em] text-[#e8eef5] uppercase">KAYS</div>
          <div class="text-[10px] font-400 tracking-[0.2em] text-[#8aa0b8] uppercase">Industries</div>
        </div>
      </a>

      <!-- Nav Links - desktop -->
      <ul class="hidden lg:flex items-center gap-8 list-none m-0 p-0">
        {["Products", "About", "Why KAYS", "Contact"].map((item) => (
          <li>
            <a
              href={`#${item.toLowerCase().replace(" ", "-")}`}
              class="text-sm font-500 tracking-wide text-[#8aa0b8] hover:text-[#e8eef5] transition-colors duration-200"
            >
              {item}
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA -->
      <a
        href="#contact"
        class="hidden lg:inline-flex items-center gap-2 px-5 py-2.5 rounded-sm bg-[#1a6eff] text-white text-sm font-600 tracking-wide hover:bg-[#3d84ff] active:scale-[0.98] transition-all duration-200"
      >
        Get a Quote
      </a>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden flex flex-col gap-1.5 p-2 cursor-pointer border-none bg-transparent"
        aria-label="Open menu"
      >
        <span class="block w-6 h-px bg-[#8aa0b8]"></span>
        <span class="block w-6 h-px bg-[#8aa0b8]"></span>
        <span class="block w-4 h-px bg-[#8aa0b8]"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile menu overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-40 bg-[#080c10] flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-all duration-300"
  >
    {["Products", "About", "Why KAYS", "Contact"].map((item) => (
      <a
        href={`#${item.toLowerCase().replace(" ", "-")}`}
        class="mobile-menu-link text-3xl font-700 tracking-tighter text-[#e8eef5] hover:text-[#1a6eff] transition-colors"
      >
        {item}
      </a>
    ))}
    <a href="#contact" class="mt-4 px-8 py-3 bg-[#1a6eff] text-white text-lg font-600 rounded-sm">
      Get a Quote
    </a>
  </div>

  <!-- ══════════════════════════════════════════════════════
       HERO — Left-aligned content, right geometric visual
  ══════════════════════════════════════════════════════ -->
  <section
    class="relative min-h-[100dvh] grid-lines overflow-hidden flex items-center"
    style="background-color: #080c10;"
  >
    <!-- Ambient glow blobs -->
    <div
      class="absolute top-1/4 right-1/4 w-[500px] h-[500px] rounded-full pointer-events-none"
      style="background: radial-gradient(circle, rgba(26,110,255,0.08) 0%, transparent 70%); filter: blur(40px);"
    ></div>
    <div
      class="absolute bottom-0 left-1/3 w-[400px] h-[400px] rounded-full pointer-events-none"
      style="background: radial-gradient(circle, rgba(26,110,255,0.05) 0%, transparent 70%); filter: blur(60px);"
    ></div>

    <div class="max-w-[1400px] mx-auto px-6 lg:px-12 w-full pt-20 pb-16 lg:pt-24 lg:pb-0">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-0 items-center min-h-[calc(100dvh-80px)]">
        <!-- Left: Copy -->
        <div class="flex flex-col justify-center">
          <!-- Eyebrow -->
          <div class="flex items-center gap-3 mb-8 animate-fade-up" style="animation-delay: 0.1s;">
            <div class="w-8 h-px bg-[#1a6eff]"></div>
            <span class="font-mono text-[11px] tracking-[0.25em] uppercase text-[#1a6eff] font-500">
              ISO 9001 Certified · Chennai, India
            </span>
          </div>

          <!-- Headline -->
          <h1
            class="font-800 tracking-tighter leading-[1.05] mb-6 animate-fade-up"
            style="font-size: clamp(2.6rem, 5.5vw, 4.5rem); animation-delay: 0.2s; color: #e8eef5;"
          >
            Precision Tools for<br />
            <em style="font-style: italic; color: #3d84ff;">Diamond</em> &amp;<br />
            Glass Cutting
          </h1>

          <!-- Subtext — max 20 words -->
          <p
            class="text-[#8aa0b8] text-lg leading-relaxed max-w-[44ch] mb-10 animate-fade-up"
            style="animation-delay: 0.3s;"
          >
            India's only fully automated manufacturer of diamond wheels, glass grinding tools, and precision abrasives.
          </p>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-4 animate-fade-up" style="animation-delay: 0.4s;">
            <a
              href="#products"
              class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-[#1a6eff] text-white text-sm font-600 tracking-wide rounded-sm hover:bg-[#3d84ff] active:scale-[0.98] transition-all duration-200"
            >
              Browse Catalogue
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
            <a
              href="#contact"
              class="inline-flex items-center gap-2 px-7 py-3.5 border border-[#242e3a] text-[#8aa0b8] text-sm font-500 rounded-sm hover:border-[#1a6eff] hover:text-[#e8eef5] active:scale-[0.98] transition-all duration-200"
            >
              Contact Us
            </a>
          </div>
        </div>

        <!-- Right: Visual composition -->
        <div class="relative flex items-center justify-center lg:justify-end h-[480px] lg:h-[100dvh]">
          <!-- Main product image -->
          <div
            class="relative z-10 rounded-sm overflow-hidden border border-[#242e3a] animate-float-slow"
            style="width: min(340px, 90vw); aspect-ratio: 3/4; box-shadow: 0 24px 80px rgba(0,0,0,0.6), 0 0 60px rgba(26,110,255,0.1);"
          >
            <img
              src="/catalogue-cover.jpg"
              alt="KAYES Industries product range"
              class="w-full h-full object-cover"
              loading="eager"
            />
            <!-- Tint overlay -->
            <div
              class="absolute inset-0"
              style="background: linear-gradient(180deg, transparent 40%, rgba(8,12,16,0.7) 100%);"
            ></div>
          </div>

          <!-- Floating stat chips -->
          <div
            class="absolute top-[15%] left-[5%] lg:left-[-5%] bg-[#0e1318] border border-[#242e3a] rounded-sm px-4 py-3 animate-fade-up"
            style="animation-delay: 0.6s; backdrop-filter: blur(12px);"
          >
            <div class="font-mono text-[10px] tracking-[0.2em] text-[#4a6478] uppercase mb-0.5">Est.</div>
            <div class="text-xl font-700 text-[#e8eef5]">35+</div>
            <div class="text-[11px] text-[#8aa0b8]">Years of precision</div>
          </div>

          <div
            class="absolute bottom-[18%] right-[5%] lg:right-[2%] bg-[#0e1318] border border-[#1a6eff]/30 rounded-sm px-4 py-3 animate-fade-up"
            style="animation-delay: 0.7s; backdrop-filter: blur(12px);"
          >
            <div class="font-mono text-[10px] tracking-[0.2em] text-[#4a6478] uppercase mb-0.5">Products</div>
            <div class="text-xl font-700 text-[#1a6eff]">200+</div>
            <div class="text-[11px] text-[#8aa0b8]">Tool variants</div>
          </div>

          <!-- Decorative rotating diamond -->
          <div
            class="absolute top-[42%] right-[-20px] lg:right-[-40px] w-20 h-20 animate-spin-slow opacity-20"
            style="border: 1px solid #1a6eff;"
            style="clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);"
          >
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40">
      <div class="font-mono text-[10px] tracking-[0.2em] uppercase text-[#4a6478]">Scroll</div>
      <div class="w-px h-8 bg-gradient-to-b from-[#4a6478] to-transparent"></div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       STATS BAR
  ══════════════════════════════════════════════════════ -->
  <section class="border-y border-[#242e3a]" style="background: #0e1318;">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-2 lg:grid-cols-4 divide-x divide-[#242e3a]">
        {[
          { value: "35+", label: "Years in Business", mono: "Est. 1990" },
          { value: "200+", label: "Product Variants", mono: "Tools" },
          { value: "Only", label: "Fully Auto Facility in India", mono: "Manufacturing" },
          { value: "ISO", label: "9001:2000 Certified", mono: "Quality" },
        ].map((stat) => (
          <div class="reveal flex flex-col gap-1 py-8 px-6 lg:px-10">
            <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-[#4a6478]">{stat.mono}</span>
            <span class="text-3xl lg:text-4xl font-800 tracking-tighter text-[#e8eef5]">{stat.value}</span>
            <span class="text-sm text-[#8aa0b8]">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       MARQUEE — product categories
  ══════════════════════════════════════════════════════ -->
  <div class="overflow-hidden py-5 border-b border-[#242e3a]" style="background: #080c10;">
    <div class="animate-marquee flex gap-12 whitespace-nowrap" style="width: max-content;">
      {Array(2).fill([
        "Diamond Grinding Wheels",
        "Glass Edge Polishing Wheels",
        "Drill Bits",
        "CNC Edge Profiling",
        "Straight Line Edger Wheels",
        "Beveling Wheels",
        "Core Drill Bits",
        "Sintered Diamond Tools",
        "Resin Bond Wheels",
        "Metal Bond Abrasives",
      ]).flat().map((item) => (
        <span class="inline-flex items-center gap-3 font-mono text-xs tracking-[0.2em] uppercase text-[#4a6478]">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#1a6eff] flex-shrink-0"></span>
          {item}
        </span>
      ))}
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════
       PRODUCTS CATALOG
  ══════════════════════════════════════════════════════ -->
  <section id="products" class="py-24 lg:py-32" style="background: #080c10;">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
      <!-- Section header -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-16">
        <div>
          <div class="flex items-center gap-3 mb-4 reveal">
            <div class="w-6 h-px bg-[#1a6eff]"></div>
            <span class="font-mono text-[11px] tracking-[0.25em] uppercase text-[#1a6eff]">Product Range</span>
          </div>
          <h2
            class="font-800 tracking-tighter leading-[1.05] reveal reveal-delay-1"
            style="font-size: clamp(2rem, 4vw, 3.2rem); color: #e8eef5;"
          >
            Tools Built for<br />Glass &amp; Stone Perfection
          </h2>
        </div>
        <p class="text-[#8aa0b8] max-w-[42ch] leading-relaxed reveal reveal-delay-2">
          Every tool is engineered to exact tolerances — built for the glass fabrication and stone cutting industries.
        </p>
      </div>

      <!-- Category grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-[#242e3a]">
        {[
          {
            code: "GW",
            name: "Grinding Wheels",
            desc: "Diamond and resin bond grinding wheels for flat, pencil edge, and OG profiles. Suitable for straight-line edgers.",
            specs: ["Diameter: 100–250mm", "Grit: 46–3000", "Bond: Metal / Resin"],
            tag: "Glass Processing",
          },
          {
            code: "PW",
            name: "Polishing Wheels",
            desc: "Felt and cerium oxide polishing wheels delivering a mirror finish on glass edges and surfaces.",
            specs: ["Profile: Flat / OG / Pencil", "Speed: 3000–6000 RPM", "Use: Wet polishing"],
            tag: "Surface Finish",
          },
          {
            code: "DB",
            name: "Diamond Drill Bits",
            desc: "Core drill bits and hole saws for drilling precise holes in glass, ceramic tiles, and stone.",
            specs: ["Dia: 4mm–150mm", "Type: Electroplated / Sintered", "Shank: SDS / Standard"],
            tag: "Drilling",
          },
          {
            code: "EP",
            name: "Edge Profiling Tools",
            desc: "CNC router bits and profile wheels for bull-nose, ogee, waterfall, and custom edge profiles.",
            specs: ["Material: PCD / Diamond", "CNC compatible", "Custom profiles available"],
            tag: "CNC / Profiling",
          },
          {
            code: "BW",
            name: "Beveling Wheels",
            desc: "Cup wheels and beveling discs for precise angled cutting on flat glass and mirrors.",
            specs: ["Angle: 15° to 45°", "Diameter: 100–200mm", "Bond: Metal sintered"],
            tag: "Beveling",
          },
          {
            code: "SA",
            name: "Sintered Abrasives",
            desc: "High-durability sintered diamond abrasives for stone, marble, granite, and engineered surfaces.",
            specs: ["Application: Stone / Marble", "Segments: T-type / L-shape", "Wet/Dry variants"],
            tag: "Stone & Marble",
          },
        ].map((product, i) => (
          <div
            class="reveal bg-[#080c10] p-8 lg:p-10 group hover:bg-[#0e1318] transition-colors duration-300"
            style={`transition-delay: ${i * 0.06}s;`}
          >
            <!-- Code badge -->
            <div class="flex items-start justify-between mb-6">
              <span class="font-mono text-xs tracking-[0.25em] bg-[#1a6eff]/10 text-[#1a6eff] px-2.5 py-1 border border-[#1a6eff]/20">
                {product.code}
              </span>
              <span class="font-mono text-[10px] tracking-[0.15em] uppercase text-[#4a6478]">
                {product.tag}
              </span>
            </div>

            <!-- Name -->
            <h3 class="text-xl font-700 tracking-tight text-[#e8eef5] mb-3 group-hover:text-[#3d84ff] transition-colors duration-300">
              {product.name}
            </h3>

            <!-- Desc -->
            <p class="text-sm text-[#8aa0b8] leading-relaxed mb-6 max-w-[40ch]">
              {product.desc}
            </p>

            <!-- Specs list -->
            <ul class="space-y-2 list-none m-0 p-0 border-t border-[#242e3a] pt-5">
              {product.specs.map((spec) => (
                <li class="flex items-center gap-2.5 text-xs text-[#4a6478] font-mono">
                  <span class="w-1 h-1 rounded-full bg-[#1a6eff] flex-shrink-0"></span>
                  {spec}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Full catalogue CTA -->
      <div class="mt-12 text-center reveal">
        <p class="text-[#8aa0b8] text-sm mb-4">Need the complete specification sheet?</p>
        <a
          href="#contact"
          class="inline-flex items-center gap-2.5 px-8 py-3.5 border border-[#242e3a] text-[#8aa0b8] text-sm font-500 rounded-sm hover:border-[#1a6eff] hover:text-[#1a6eff] active:scale-[0.98] transition-all duration-200"
        >
          Request Full Catalogue
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       ABOUT — Asymmetric split
  ══════════════════════════════════════════════════════ -->
  <section id="about" class="py-24 lg:py-32 border-t border-[#242e3a]" style="background: #0e1318;">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-12 lg:gap-20 items-center">
        <!-- Left: image block -->
        <div class="relative reveal">
          <div
            class="rounded-sm overflow-hidden border border-[#242e3a]"
            style="aspect-ratio: 4/5; box-shadow: 0 32px 80px rgba(0,0,0,0.5);"
          >
            <img
              src="/catalogue-cover.jpg"
              alt="KAYES Industries manufacturing facility"
              class="w-full h-full object-cover object-top"
              loading="lazy"
            />
            <div
              class="absolute inset-0"
              style="background: linear-gradient(135deg, rgba(26,110,255,0.05) 0%, transparent 60%);"
            ></div>
          </div>

          <!-- Floating label -->
          <div
            class="absolute -bottom-5 -right-5 lg:-right-8 bg-[#1a6eff] text-white px-5 py-4 rounded-sm"
          >
            <div class="font-mono text-[10px] tracking-[0.2em] uppercase opacity-70 mb-0.5">Manufacturer</div>
            <div class="text-base font-700 tracking-tight">Fully Automated</div>
            <div class="text-xs opacity-80">Only in India</div>
          </div>
        </div>

        <!-- Right: copy -->
        <div class="flex flex-col gap-6">
          <div class="flex items-center gap-3 reveal">
            <div class="w-6 h-px bg-[#1a6eff]"></div>
            <span class="font-mono text-[11px] tracking-[0.25em] uppercase text-[#1a6eff]">About KAYES</span>
          </div>

          <h2
            class="font-800 tracking-tighter leading-[1.05] reveal reveal-delay-1"
            style="font-size: clamp(1.8rem, 3.5vw, 2.8rem); color: #e8eef5;"
          >
            Preferred Partners for<br />
            <em style="color: #3d84ff; font-style: italic;">Glass Pre-Processing</em>
          </h2>

          <p class="text-[#8aa0b8] leading-relaxed max-w-[52ch] reveal reveal-delay-2">
            Kayes Industries has been at the forefront of diamond tooling and glass abrasive manufacturing for over three decades.
            Based in T. Nagar, Chennai, we supply precision tools to glass fabricators, stone processors, and industrial facilities across India and beyond.
          </p>
          <p class="text-[#8aa0b8] leading-relaxed max-w-[52ch] reveal reveal-delay-3">
            Our fully automated production line - the only one of its kind in India - ensures consistent quality, exact tolerances, and faster delivery cycles than any competitor.
          </p>

          <!-- Key facts grid -->
          <div class="grid grid-cols-2 gap-4 mt-4 reveal reveal-delay-4">
            {[
              { label: "ISO 9001:2000", sub: "Quality Certified" },
              { label: "Chennai, India", sub: "T. Nagar, HQ" },
              { label: "Global Supply", sub: "Export capability" },
              { label: "D. Kamal Nathan", sub: "Chief Executive" },
            ].map((fact) => (
              <div class="border border-[#242e3a] p-4 rounded-sm hover:border-[#1a6eff]/30 transition-colors duration-300">
                <div class="text-sm font-600 text-[#e8eef5] mb-0.5">{fact.label}</div>
                <div class="text-xs text-[#4a6478] font-mono">{fact.sub}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       WHY KAYS — Bento grid
  ══════════════════════════════════════════════════════ -->
  <section id="why-kays" class="py-24 lg:py-32 border-t border-[#242e3a]" style="background: #080c10;">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
      <div class="flex items-center gap-3 mb-4 reveal">
        <div class="w-6 h-px bg-[#1a6eff]"></div>
        <span class="font-mono text-[11px] tracking-[0.25em] uppercase text-[#1a6eff]">Why KAYS</span>
      </div>
      <h2
        class="font-800 tracking-tighter leading-[1.05] mb-16 reveal reveal-delay-1"
        style="font-size: clamp(2rem, 4vw, 3.2rem); color: #e8eef5;"
      >
        The Industrial Standard<br />for Precision Tooling
      </h2>

      <!-- 5-cell bento: [tall-left | 2-right-top | 2-right-bottom] -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-[#242e3a]">
        <!-- Cell 1: tall, spans 2 rows on lg -->
        <div
          class="reveal bg-[#0e1318] p-8 lg:p-10 lg:row-span-2 flex flex-col justify-between min-h-[320px]"
          style="background: linear-gradient(135deg, #0e1318 0%, #111a24 100%);"
        >
          <div>
            <div class="w-12 h-12 rounded-sm bg-[#1a6eff]/10 border border-[#1a6eff]/20 flex items-center justify-center mb-6">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1a6eff" stroke-width="1.8">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            </div>
            <h3 class="text-xl font-700 tracking-tight text-[#e8eef5] mb-3">Only Fully Automated Manufacturer in India</h3>
            <p class="text-sm text-[#8aa0b8] leading-relaxed max-w-[36ch]">
              Our fully automated diamond tool manufacturing process is the first and only of its kind in India - delivering unmatched consistency and zero human error in every batch.
            </p>
          </div>
          <div class="font-mono text-[11px] tracking-[0.2em] uppercase text-[#1a6eff] mt-8">Automation · Precision</div>
        </div>

        <!-- Cell 2 -->
        <div class="reveal reveal-delay-1 bg-[#080c10] p-8">
          <div class="w-10 h-10 rounded-sm bg-[#1a6eff]/10 border border-[#1a6eff]/20 flex items-center justify-center mb-5">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a6eff" stroke-width="1.8">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="text-lg font-700 text-[#e8eef5] mb-2 tracking-tight">ISO 9001:2000 Quality System</h3>
          <p class="text-sm text-[#8aa0b8] leading-relaxed">Certified quality management ensures every tool ships to spec.</p>
        </div>

        <!-- Cell 3 -->
        <div class="reveal reveal-delay-2 bg-[#080c10] p-8">
          <div class="w-10 h-10 rounded-sm bg-[#1a6eff]/10 border border-[#1a6eff]/20 flex items-center justify-center mb-5">
