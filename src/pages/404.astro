---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | KAYS INDUSTRIES PVT LTD" description="The page you are looking for does not exist. Return to KAYS INDUSTRIES PVT LTD homepage.">
  <div class="min-h-[70vh] flex flex-col items-center justify-center px-6 text-center bg-white">
    <div class="flex items-center gap-3 mb-8 select-none">
      <div class="w-10 h-10 rounded-xl overflow-hidden bg-white flex items-center justify-center flex-shrink-0 shadow-2xs border border-slate-200 p-1">
        <img src="/images/brand/kays-logo-1x1.svg" alt="KAYS Diamond Tools" class="w-full h-full object-contain" />
      </div>
      <div class="flex flex-col text-left">
        <div class="flex items-center gap-1.5 leading-none">
          <span class="text-xl font-bold tracking-[0.08em] font-brand text-slate-900">KAYS</span>
          <span class="text-xs font-semibold tracking-[0.18em] font-brand text-slate-700">INDUSTRIES</span>
        </div>
        <span class="text-[10px] font-medium tracking-normal mt-0.5 text-slate-500">KAYS INDUSTRIES PVT LTD</span>
      </div>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-slate-900 mb-4">Page not found</h1>
    <p class="text-slate-600 mb-8 max-w-md">Sorry, we couldn't find the page you are looking for. It may have been moved or does not exist.</p>
    <a href="/" class="inline-flex items-center justify-center bg-slate-900 text-white px-6 py-3 rounded-lg font-medium hover:bg-slate-800 transition-colors">Back to home</a>
  </div>
</Layout>
