---
import Layout from '../layouts/Layout.astro';
import { BusinessHeader } from '../components/BusinessHeader';
import { Footer } from '../components/Footer';
import { COMPANY_INFO } from '../data/company';
---

<Layout title="About Us | KAYES INDUSTRIES PVT LTD" description="KAYES INDUSTRIES PVT LTD, Chennai - ISO 9001:2015 manufacturer of diamond tools. Our facility, executive heritage, and commitment to micron tolerances.">
  <BusinessHeader client:load />
  <main class="flex-grow bg-white">
    <section id="about" class="border-b border-slate-200 bg-slate-50 scroll-mt-28">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold tracking-widest uppercase text-slate-500">About Us</p>
          <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 font-brand">Pioneering Precision Superabrasives</h1>
          <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
            Founded with an uncompromising focus on precision engineering, KAYES INDUSTRIES PVT LTD operates high-temperature sintering presses and CNC automated balancing lines serving global glass fabricators. Precision machined to exact tolerances. Built to run at full speed. Guaranteed to satisfy.
          </p>
        </div>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <div class="lg:col-span-5">
          <div class="bg-white border border-slate-200 rounded-2xl p-6">
            <img src="/images/brand/executive-portrait.jpg" alt="Chief Executive" class="w-full h-auto max-h-[420px] object-contain bg-slate-50 rounded-xl border border-slate-200" />
            <h3 class="mt-4 text-base font-semibold text-slate-900">{COMPANY_INFO.executive.name} — {COMPANY_INFO.executive.title}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              Leading a dedicated R&D team developing sub-micron diamond matrices for silicon wafers and alumina ceramics. Our facility is a modest industrial shed - no architectural render, just real production capability.
            </p>
          </div>
          <div class="mt-6 bg-slate-900 text-slate-200 rounded-2xl p-6">
            <h4 class="text-sm font-semibold text-white">Facility</h4>
            <p class="mt-2 text-sm text-slate-400">Realistic industrial shed with parking and trees - modest, functional, and fully automatic. Image to be updated with client-provided shed photo.</p>
            <div class="mt-4 bg-white/10 border border-white/10 rounded-xl h-32 flex items-center justify-center text-xs text-slate-400">Factory shed placeholder</div>
          </div>
        </div>
        <div class="lg:col-span-7 space-y-6">
          <div class="grid grid-cols-3 gap-4">
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center">
              <div class="text-2xl font-bold text-slate-900">ISO</div><div class="text-xs text-slate-500">9001:2015 Certified</div>
            </div>
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center">
              <div class="text-2xl font-bold text-slate-900">Only</div><div class="text-xs text-slate-500">Fully Automatic Facility in India</div>
            </div>
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center">
              <div class="text-2xl font-bold text-slate-900">Chennai</div><div class="text-xs text-slate-500">Plant & Sales Office</div>
            </div>
          </div>
          <div class="prose prose-slate max-w-none text-sm leading-relaxed">
            <p>KAYES is the only manufacturer in India with a fully automatic facility for diamond tools. Our superabrasive wheels and drills are engineered for high-speed durability and exacting tolerances.</p>
            <p>We serve architectural, automotive, watch & sapphire, solar, scientific, semiconductor & ceramics, appliance, and container glass - with tool-to-photo traceability to WhatsApp reference assets.</p>
          </div>
          <div class="flex gap-3">
            <a href="/products" class="inline-flex items-center justify-center bg-slate-900 text-white text-sm font-semibold rounded-xl px-5 h-10">Browse Products</a>
            <a href="/contact" class="inline-flex items-center justify-center border border-slate-200 rounded-xl px-5 h-10 text-sm font-semibold">Contact</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer client:idle />
</Layout>
