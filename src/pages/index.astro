---
import Layout from '../layouts/Layout.astro';
import { BusinessHeader } from '../components/BusinessHeader';
import { Hero } from '../components/Hero';
import { TrustStrip } from '../components/TrustStrip';
import { ClientMarquee } from '../components/ClientMarquee';
import { HomeIndustriesTeaser } from '../components/HomeIndustriesTeaser';
import { Footer } from '../components/Footer';
import { COMPANY_INFO } from '../data/company';
import { CATALOG_PRODUCTS } from '../data/catalog';
---

<Layout>
  <BusinessHeader client:load isHomePage={true} />
  <main id="main-content" class="flex-grow">
    <Hero client:load />
    <TrustStrip />
    <ClientMarquee client:visible />
    <HomeIndustriesTeaser client:load />

    <!-- Products teaser -->
    <section class="py-10 bg-slate-50 border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 font-brand">Product Families</h2>
        <p class="mt-1 text-sm text-slate-600">Five families, ISO profiles 6A2 to 1FF1, with dimensional tables. Download the catalogue for the full matrix.</p>
        <div class="mt-6 grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
          {CATALOG_PRODUCTS.slice(0,5).map((p) => (
            <a href="/products" class="border border-slate-200 rounded-2xl overflow-hidden bg-white hover:border-slate-300 transition-colors">
              <img src={p.image} alt={p.name} class="w-full h-28 object-cover border-b border-slate-200" />
              <div class="p-3">
                <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">{p.categoryName}</div>
                <h3 class="mt-1 text-xs font-semibold text-slate-900 line-clamp-2">{p.name}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Facility strip -->
    <section class="py-10 bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-5">
            <h2 class="text-xl font-bold tracking-tight text-slate-900 font-brand">Fully Automatic Facility - Chennai</h2>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">Only manufacturer in India with a fully automatic plant for diamond tools. Modest industrial shed - real production, no render. High-temperature sintering and CNC balancing for exact tolerances.</p>
            <div class="mt-4 flex gap-2">
              <a href="/about" class="inline-flex items-center justify-center bg-slate-900 text-white text-sm font-semibold rounded-xl px-5 h-10">About Us</a>
              <a href="/contact" class="inline-flex items-center justify-center border border-slate-200 rounded-xl px-5 h-10 text-sm font-semibold">Contact</a>
            </div>
          </div>
          <div class="lg:col-span-7">
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4">
              <div class="bg-white border border-slate-200 rounded-xl h-48 flex items-center justify-center text-xs text-slate-400">Factory shed image placeholder - awaiting client file</div>
              <div class="mt-3 grid grid-cols-3 gap-3 text-center">
                <div class="bg-white border border-slate-200 rounded-xl py-2"><div class="text-sm font-bold text-slate-900">Micron</div><div class="text-[11px] text-slate-500">Tolerances</div></div>
                <div class="bg-white border border-slate-200 rounded-xl py-2"><div class="text-sm font-bold text-slate-900">High-Speed</div><div class="text-[11px] text-slate-500">Durability</div></div>
                <div class="bg-white border border-slate-200 rounded-xl py-2"><div class="text-sm font-bold text-slate-900">Guaranteed</div><div class="text-[11px] text-slate-500">Satisfaction</div></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer client:idle />
</Layout>
