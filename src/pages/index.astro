---
import Layout from '../layouts/Layout.astro';
import { Hero } from '../components/Hero';
import { IndustriesOverview } from '../components/IndustriesOverview';
import { InteractiveCatalog } from '../components/InteractiveCatalog';
import { WheelProfilesBlueprint } from '../components/WheelProfilesBlueprint';
import { GritParticleMatrix } from '../components/GritParticleMatrix';
import { CorporateProfile } from '../components/CorporateProfile';
import { InteractiveRFQ } from '../components/InteractiveRFQ';
import { Footer } from '../components/Footer';
import { AssistedSectionNav } from '../components/AssistedSectionNav';
---

<Layout>
  <!-- Floating Assisted Section Navigator -->
  <AssistedSectionNav client:load />

  <!-- Main Content -->
  <main class="flex-grow">
    <!-- Brand Entrance Screen (Full Viewport Centered on Visit/Refresh) -->
    <Hero client:load />

    <!-- Glass Sectors & Semiconductor/Ceramic R&D Overview (Split Showcase) -->
    <IndustriesOverview client:visible />

    <!-- Technical Product Catalog Grid (Bento Grid) -->
    <InteractiveCatalog client:visible />

    <!-- ISO Wheel Types Guide (CAD Technical Blueprint Workbench) -->
    <WheelProfilesBlueprint client:visible />

    <!-- Surface Metallurgy & Particle Progression Matrix -->
    <GritParticleMatrix client:visible />

    <!-- Corporate Profile & Executive Heritage (Editorial Layout) -->
    <CorporateProfile client:visible />

    <!-- RFQ Requisition Configurator & Plant Contacts -->
    <InteractiveRFQ client:visible />
  </main>

  <!-- Corporate Footer -->
  <Footer client:visible />
</Layout>
