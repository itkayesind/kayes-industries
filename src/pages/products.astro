---

<Layout title="Products | KAYES INDUSTRIES PVT LTD" description="Diamond wheels, drills, polishing and resin wheels by KAYES INDUSTRIES PVT LTD. ISO profiles 6A2, 11A2, 1FF1 etc. with machine compatibility.">
  <BusinessHeader client:load />
  <main class="flex-grow bg-white">
    <section class="border-b border-slate-200 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <p class="text-xs font-semibold tracking-widest uppercase text-slate-500">Products</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 font-brand">Tool Catalogue</h1>
        <p class="mt-2 text-sm text-slate-600 max-w-2xl">Browse by ToolFamily — select a category on the left. Each profile links to ISO drawing + dimensions. Download the full PDF for the complete matrix.</p>
        <div class="mt-4 flex gap-2">
          <a href={COMPANY_INFO.contacts.catalogPdf} download class="inline-flex items-center text-sm font-semibold bg-slate-900 text-white rounded-xl px-5 h-10">Download Catalogue PDF</a>
          <a href="/contact" class="inline-flex items-center text-sm font-semibold border border-slate-200 rounded-xl px-5 h-10">Request Quote</a>
        </div>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <aside class="lg:col-span-3">
          <div class="sticky top-[88px] border border-slate-200 rounded-2xl bg-white overflow-hidden">
            <div class="bg-slate-900 text-white px-4 py-3">
              <h2 class="text-sm font-semibold">Product Categories</h2>
              <p class="text-[11px] text-slate-300">Select to view details</p>
            </div>
            <nav class="p-2 space-y-1">
              {families.map((f) => (
                <a href={`#${f.id}`} class="block rounded-xl px-3 py-2.5 hover:bg-slate-50 border border-transparent hover:border-slate-200">
                  <div class="text-sm font-semibold text-slate-900">{f.label}</div>
                  <div class="text-xs text-slate-500 line-clamp-2">{f.desc}</div>
                  <div class="mt-1 flex flex-wrap gap-1">
                    {f.profiles.slice(0,3).map((p) => <span class="text-[10px] font-mono bg-slate-100 border border-slate-200 rounded-full px-1.5 py-0.5">{p}</span>)}
                    {f.profiles.length > 3 && <span class="text-[10px] text-slate-400">+{f.profiles.length-3}</span>}
                  </div>
                </a>
              ))}
              <div class="pt-2 border-t border-slate-100 space-y-1">
                <a href="#applications" class="block rounded-xl px-3 py-2 text-xs font-semibold text-cyan-900 bg-cyan-50/70 hover:bg-cyan-100/70 border border-cyan-200/60">
                  ✦ Application Showcase (16)
                </a>
                <a href="#whatsapp-stock" class="block rounded-xl px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50">
                  WhatsApp Stock (37)
                </a>
                <a href="#architecture" class="block rounded-xl px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50">
                  Architecture Glass (35)
                </a>
                <a href="#automotive" class="block rounded-xl px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50">
                  Automotive Glass (30)
                </a>
                <a href="#watch" class="block rounded-xl px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50">
                  Watch & Scientific (38)
                </a>
                <a href="#special" class="block rounded-xl px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50">
                  Special Tools (28)
                </a>
              </div>
            </nav>
            <div class="border-t border-slate-200 p-3 bg-slate-50">
              <p class="text-xs text-slate-600">Need help? <a href="/contact" class="font-semibold text-slate-900">Contact Sales</a></p>
            </div>
          </div>
        </aside>

        <div class="lg:col-span-9 space-y-8">
          {families.map((f) => (
            <section id={f.id} class="scroll-mt-28 border border-slate-200 rounded-2xl bg-white overflow-hidden">
              <div class="px-5 py-4 border-b border-slate-200 bg-slate-50">
                <h2 class="text-lg font-bold text-slate-900">{f.label}</h2>
                <p class="mt-1 text-sm text-slate-600">{f.longDesc}</p>
              </div>
              <div class="p-5 space-y-5">
                <div>
                  <h3 class="text-xs font-semibold tracking-widest uppercase text-slate-500">ISO Profiles & Stock</h3>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {f.profiles.map((p) => {
                      const wp = WHEEL_PROFILES.find((w) => w.code === p);
                      return <span class="text-xs font-mono bg-white border border-slate-200 rounded-full px-2.5 py-1">{p}{wp ? ` · ${wp.name}` : ''}</span>
                    })}
                  </div>
                </div>

                <div>
                  <h3 class="text-xs font-semibold tracking-widest uppercase text-slate-500">Tooling Catalogue Showcase</h3>
                  <div class="mt-2.5 grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {CATALOG_PRODUCTS.filter((prod) => {
                      const map = {
                        'diamond-wheels': ['glass-edging-wheels','glass-core-drills-milling'],
                        'drills': ['glass-core-drills-milling'],
                        'grinding': ['glass-edging-wheels'],
                        'polishing': ['glass-edging-wheels'],
                        'resin-wheels': ['glass-edging-wheels'],
                        'custom': ['glass-core-drills-milling']
                      };
                      return (map[f.id] || []).includes(prod.id);
                    }).slice(0,2).map((p) => (
                      <div class="border border-slate-200 rounded-xl overflow-hidden bg-slate-50/50">
                        <img src={p.image} alt={p.name} class="w-full h-36 object-cover border-b border-slate-200" />
                        <div class="p-3">
                          <div class="text-[11px] font-semibold uppercase text-slate-500">{p.categoryName}</div>
                          <div class="text-sm font-semibold text-slate-900 line-clamp-2">{p.name}</div>
                          <p class="mt-1 text-xs text-slate-600 line-clamp-2">{p.summary}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                {f.appCodes && f.appCodes.length > 0 && (
                  <div class="pt-3 border-t border-slate-100">
                    <div class="flex items-center justify-between mb-2">
                      <h3 class="text-xs font-semibold tracking-widest uppercase text-cyan-900 flex items-center gap-1.5 font-mono">
                        <span class="w-2 h-2 rounded-full bg-cyan-600"></span>
                        Key Application Showcase
                      </h3>
                      <a href="#applications" class="text-[11px] font-medium text-cyan-700 hover:text-cyan-900">View all 16 applications &rarr;</a>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                      {f.appCodes.map((code) => {
                        const app = APPLICATION_IMAGES.find((a) => a.code === code);
                        if (!app) return null;
                        return (
                          <div class="group border border-slate-200 rounded-xl overflow-hidden bg-white hover:border-slate-300">
                            <div class="relative aspect-[4/3] bg-slate-900 overflow-hidden">
                              <img src={app.src} alt={app.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                              <span class="absolute bottom-1 left-1 bg-black/80 text-[9px] font-mono font-bold text-cyan-300 px-1.5 py-0.5 rounded">
                                {app.code}
                              </span>
                            </div>
                            <div class="p-2">
                              <div class="text-[11px] font-bold text-slate-900 truncate font-brand">{app.title}</div>
                              <div class="text-[10px] text-slate-500 truncate">{app.sectorName}</div>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                )}
              </div>
            </section>
          ))}

          <section class="border border-slate-200 rounded-2xl p-5 bg-slate-50">
            <h3 class="text-sm font-semibold text-slate-900">ISO Wheel Profiles Directory</h3>
            <p class="mt-1 text-xs text-slate-600">Engineering profile drawings with dimensional table (D, H, W, X, T, R) - e.g., 6A2, 9A3, 11A2, 1EE1, 1FF1. Dimensions from ISO 6104 and stock tables (not just PDF prose).</p>
            <div class="mt-3 grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-2">
