---
import Layout from "../../../layouts/Layout.astro";
import { BusinessHeader } from "../../../components/BusinessHeader";
import { Footer } from "../../../components/Footer";
import { LightboxGallery } from "../../../components/LightboxGallery";
import { TOOL_FAMILIES, FAMILY_PRODUCT_MAP, INDUSTRY_GALLERIES } from "../../../data/productFamilies";
import { WHEEL_PROFILES } from "../../../data/wheelProfiles";
import { CATALOG_PRODUCTS } from "../../../data/catalog";
import { APPLICATION_IMAGES, COMPANY_INFO } from "../../../data/company";

export function getStaticPaths() {
  return TOOL_FAMILIES.map((f) => ({ params: { id: f.id } }));
}

const { id } = Astro.params;
const family = TOOL_FAMILIES.find((f) => f.id === id);
if (!family) throw new Error(`Unknown family ${id}`);

const idx = TOOL_FAMILIES.findIndex((f) => f.id === id);
const prev = idx > 0 ? TOOL_FAMILIES[idx - 1] : null;
const next = idx < TOOL_FAMILIES.length - 1 ? TOOL_FAMILIES[idx + 1] : null;

const productIds = FAMILY_PRODUCT_MAP[family.id] ?? [];
const products = CATALOG_PRODUCTS.filter((p) => productIds.includes(p.id));

const appImages = family.appCodes
  .map((code) => APPLICATION_IMAGES.find((a) => a.code === code))
  .filter(Boolean) as typeof APPLICATION_IMAGES;

// Filtered mapping: family -> relevant factory galleries (1-2 slugs).
// Polishing now single gallery (architecture) to cut 30 automotive drills pollution.
// Filtering trims remaining galleries to only relevant captions per family.
// - diamond-wheels: edging for facades/windshields -> architecture + automotive (filtered to wheels)
// - drills: thin-wall core drills -> drills only (20) — keep all
// - grinding: peripheral/slitting for solar & appliance -> architecture + special (filtered)
// - polishing: high-gloss finish for edged glass -> architecture only (filtered to cerium/BD/GOMMA)
// - resin-wheels: fine resin/cup for arrissing -> special only (filtered to resin/pencil)
// - custom: bespoke/mounted points -> watch + special (filtered lightly, keep most)
const FAMILY_GALLERY_MAP: Record<string, string[]> = {
  "diamond-wheels": ["architecture", "automotive"],
  "drills": ["drills"],
  "grinding": ["architecture", "special"],
  "polishing": ["architecture"],
  "resin-wheels": ["special"],
  "custom": ["watch", "special"],
};

function includesAny(haystack: string, needles: string[]): boolean {
  const l = haystack.toLowerCase();
  return needles.some((k) => l.includes(k.toLowerCase()));
}

function isRelevant(caption: string, familyId: string): boolean {
  const l = caption.toLowerCase();
  if (familyId === "drills") return true;
  if (familyId === "diamond-wheels") {
    const wheelKw = ["wheel","cup","periphery","peripheral","pdt","spectrum","pos","segmented","continuous","groove","rim","pencil","v-groove"];
    const hasWheel = includesAny(l, wheelKw);
    // Exclude pure drill/dresser/adapter/finger if no wheel signal
    if (!hasWheel) return false;
    // Additional guard: if caption is drill/dresser/adapter without wheel, already false
    return hasWheel;
  }
  if (familyId === "grinding") {
    const kws = ["grind","periphery","peripheral","slit","d1a1","1a1","pdt","cut-off","slitting","disc","pdt","lapping"];
    // Exclude obvious drill-only without grinding term? Already filtered via kws
    return includesAny(l, kws);
  }
  if (familyId === "polishing") {
    // Polishing: cerium/BD/GOMMA/X3000/terracotta/resin/salmon/10S/1309 family. Resin generic allowed to keep green resin cups as polish-adjacent; tool pollution gated.
    const polishCore = ["polish","cerium","bd-8","bd","gomma","x3000","terracotta","resin","salmon","10s","1309","ceria","rubber"];
    const hasPolish = includesAny(l, polishCore);
    // Exclude drills/dressers/adapters/fingers without polish signal (e.g. Pink-Brown finger bit)
    const isToolPollution = includesAny(l, ["drill","dresser","adapter","finger","mushroom","stub","conical"]);
    if (isToolPollution && !hasPolish) return false;
    // Resin check already via polishCore (resin); no extra gate needed
    // Pink alone without core polish is not polishing
    if (l.includes("pink") && !hasPolish) return false;
    return hasPolish;
  }
  if (familyId === "resin-wheels") {
    const kws = ["resin","terracotta","bd","seamer","arriss","pencil","rubber","polish","cerium","gomma","salmon","pink","10s"];
    return includesAny(l, kws);
  }
  if (familyId === "custom") {
    if (l.includes("price list")) return false;
    // watch+special already custom-relevant; keep most, only exclude obvious non-custom like price doc
    const kws = ["generator","dresser","mounted","pcd","cbn","watch","hand file","drum","roller","profile","burr","lapping","slitting","cut-off","torus","pill","shank","milling","router","barrel","cup","peripheral","d1a1","disc","wheel","groove","rim"];
    // Permissive: if any kw matches keep, otherwise still keep unless price list
    return includesAny(l, kws) || true;
  }
  return true;
}

type FilteredGallery = typeof INDUSTRY_GALLERIES[number] & {
  filtered: { caption: string; originalIdx: number }[];
  effective: { caption: string; originalIdx: number }[];
};

const galleriesForFamily: FilteredGallery[] = (FAMILY_GALLERY_MAP[family.id] ?? [])
  .map((slug) => INDUSTRY_GALLERIES.find((g) => g.slug === slug))
  .filter(Boolean)
  .map((g) => {
    const withIdx = (g as typeof INDUSTRY_GALLERIES[number]).captions.map((caption, originalIdx) => ({ caption, originalIdx }));
    const filtered = withIdx.filter(({ caption }) => isRelevant(caption, family.id));
    // Relax if <8: keep filtered plus filler from original to reach 8, or fallback to original if empty
    let effective = filtered;
    if (filtered.length === 0) effective = withIdx;
    else if (filtered.length < 8) {
      // Relax: keep filtered but pad with originals not yet included to reach at least 8 or original length (whichever smaller)
      const needed = Math.min(8, withIdx.length) - filtered.length;
      const filler = withIdx.filter((x) => !filtered.some((f) => f.originalIdx === x.originalIdx)).slice(0, needed);
      // For polishing/drills where strict <8, prefer filtered + filler over full revert to preserve relevance
      // But if filtered <4 (too aggressive), fallback to original to avoid misleading pad
      if (filtered.length < 4) effective = withIdx;
      else effective = [...filtered, ...filler];
    }
    return { ...(g as typeof INDUSTRY_GALLERIES[number]), filtered, effective };
  }) as FilteredGallery[];

const totalFactoryImages = galleriesForFamily.reduce((s, g) => s + g.count, 0);
const totalRelevantImages = galleriesForFamily.reduce((s, g) => s + g.effective.length, 0);
---

<Layout title={`${family.label} | KAYES`} description={`${family.label} — ${family.longDesc}`}>
  <BusinessHeader client:load />
  <main class="flex-grow bg-white">
    <div class="border-b border-slate-200 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <nav class="text-xs text-slate-500 flex items-center gap-1.5">
          <a href="/products" class="hover:text-slate-900">Products</a>
          <span>/</span>
          <span class="font-semibold text-slate-900">{family.label}</span>
        </nav>
        <h1 class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 font-brand">{family.label}</h1>
        <p class="mt-2 text-sm text-slate-600 max-w-3xl leading-relaxed">{family.longDesc}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href={COMPANY_INFO.contacts.catalogPdf} download class="inline-flex items-center text-sm font-semibold bg-slate-900 text-white rounded-xl px-5 h-10 hover:bg-slate-800">Download PDF</a>
          <a href="/contact" class="inline-flex items-center text-sm font-semibold border border-slate-200 rounded-xl px-5 h-10 bg-white hover:bg-slate-50">Request Quote</a>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Left nav -->
      <aside class="lg:col-span-3">
        <div class="sticky top-[88px] border border-slate-200 rounded-2xl bg-white overflow-hidden">
          <div class="bg-slate-900 text-white px-4 py-3">
            <h2 class="text-sm font-semibold">ToolFamilies</h2>
            <p class="text-[11px] text-slate-300">6 families — you are here</p>
          </div>
          <nav class="p-2 space-y-1">
            {TOOL_FAMILIES.map((f) => (
              <a href={`/products/family/${f.id}`} class={`block rounded-xl px-3 py-2.5 border ${f.id === family.id ? "bg-slate-900 text-white border-slate-900" : "hover:bg-slate-50 border-transparent hover:border-slate-200"}`}>
                <div class={`text-sm font-semibold ${f.id === family.id ? "text-white" : "text-slate-900"}`}>{f.label}</div>
                <div class={`text-xs line-clamp-1 ${f.id === family.id ? "text-slate-300" : "text-slate-500"}`}>{f.shortDesc}</div>
              </a>
            ))}
          </nav>
          <div class="border-t border-slate-200 p-3 bg-slate-50 flex items-center justify-between text-xs">
            <a href="/products" class="font-semibold text-slate-900 hover:underline">← All products</a>
            <a href="/products/profiles" class="text-slate-600 hover:text-slate-900">ISO profiles</a>
          </div>
        </div>
      </aside>

      <div class="lg:col-span-9 space-y-6">
        <!-- Hero image -->
        <section class="border border-slate-200 rounded-2xl overflow-hidden bg-white hover:border-slate-300 hover:shadow-sm transition-all">
          <img src={family.heroImage} alt={family.label} class="w-full h-56 sm:h-72 object-cover bg-slate-50" loading="eager" />
          <div class="px-5 py-3 border-t border-slate-200 bg-slate-50/50 flex items-center justify-between gap-4">
            <p class="text-xs text-slate-600"><span class="font-semibold text-slate-900">{family.label}</span> — {family.shortDesc}</p>
            <span class="hidden sm:inline text-[11px] font-mono bg-white border border-slate-200 rounded-full px-2.5 py-1 text-slate-600">{family.profiles.join(" · ")}</span>
          </div>
        </section>

        <!-- Profiles -->
        <section class="border border-slate-200 rounded-2xl p-5 bg-white">
          <h2 class="text-xs font-semibold tracking-widest uppercase text-slate-500">ISO Profiles in this family</h2>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {family.profiles.map((code) => {
              const wp = WHEEL_PROFILES.find((w) => w.code === code);
              return <a href="/products/profiles" class="text-xs font-mono bg-white border border-slate-200 rounded-full px-2.5 py-1 hover:border-slate-300">{code}{wp ? ` · ${wp.name}` : ""}</a>;
            })}
          </div>
          <p class="mt-3 text-xs text-slate-600">Full dimensional table (D, H, W, X, T, R) on the <a href="/products/profiles" class="font-semibold text-slate-900 underline">profiles directory</a>.</p>
        </section>

        <!-- Products — enriched cards matching /products index style -->
        {products.length > 0 && (
          <section class="border border-slate-200 rounded-2xl overflow-hidden bg-white">
            <div class="px-5 py-4 border-b border-slate-200 bg-slate-50">
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="text-sm font-bold text-slate-900">Catalogue products in this family</h2>
                <span class="text-xs text-slate-500">{products.length} product{products.length > 1 ? "s" : ""}</span>
              </div>
              <p class="text-xs text-slate-600 mt-1">Specs, features and compatible machines — {products.map((p) => p.name).join(" · ")}.</p>
            </div>
            <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
              {products.map((p) => (
                <div class="group border border-slate-200 rounded-2xl overflow-hidden bg-white hover:border-slate-300 hover:shadow-sm transition-all flex flex-col">
                  <div class="relative h-48 overflow-hidden bg-slate-50 border-b border-slate-200">
                    <img src={p.image} alt={p.name} class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500" loading="lazy" />
                    <span class="absolute top-3 left-3 bg-white/90 backdrop-blur text-slate-700 text-[10px] font-semibold tracking-widest uppercase px-2 py-1 rounded-md border border-slate-200 shadow-sm">{p.categoryName}</span>
                  </div>
                  <div class="p-4 flex flex-col flex-grow">
                    <div class="text-sm font-bold text-slate-900 leading-tight">{p.name}</div>
                    <p class="mt-1.5 text-xs text-slate-600 leading-relaxed line-clamp-3">{p.summary}</p>
                    {p.features?.length > 0 && (
                      <ul class="mt-3 space-y-1">
                        {p.features.slice(0, 4).map((feat) => (
                          <li class="text-xs text-slate-600 flex gap-1.5 leading-snug"><span class="text-slate-400 shrink-0">•</span><span>{feat}</span></li>
                        ))}
                      </ul>
                    )}
                    {p.specs?.length > 0 && (
                      <dl class="mt-3 pt-3 border-t border-slate-100 grid grid-cols-1 gap-1.5">
                        {p.specs.slice(0, 4).map((s) => (
                          <div class="flex gap-2 text-xs"><dt class="font-semibold text-slate-700 shrink-0">{s.label}:</dt><dd class="text-slate-600">{s.value}</dd></div>
                        ))}
                      </dl>
                    )}
                    {p.shapes && p.shapes.length > 0 && (
                      <div class="mt-3 flex flex-wrap gap-1">
                        {p.shapes.map((shape) => (
                          <span class="text-[11px] font-mono bg-slate-50 border border-slate-200 rounded-full px-2 py-0.5 text-slate-700">{shape}</span>
                        ))}
                      </div>
                    )}
                    <div class="mt-3 flex items-center justify-between gap-2">
                      <span class="text-[11px] text-slate-500">{p.pageRef}</span>
                      {p.targetSectors && p.targetSectors.length > 0 && (
                        <span class="text-[11px] text-slate-500 line-clamp-1 hidden sm:inline">{p.targetSectors.slice(0, 2).join(" · ")}</span>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Factory Photos — filtered to family-relevant captions; index-preserving src mapping -->
        {galleriesForFamily.length > 0 && (
          <section class="border border-slate-200 rounded-2xl overflow-hidden bg-white">
            <div class="px-5 py-4 border-b border-slate-200 bg-slate-50">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="text-sm font-bold text-slate-900">Factory Photos — {family.label}</h2>
                <span class="text-xs font-medium bg-white border border-slate-200 rounded-full px-2.5 py-1 text-slate-700">Showing {totalRelevantImages} relevant of {totalFactoryImages} tools</span>
              </div>
              <p class="mt-1 text-xs text-slate-600 leading-relaxed">Real factory photos from {galleriesForFamily.map((g) => g.label).join(" + ")} — filtered to family-relevant tools (keyword-matched captions, original file numbers preserved). Click any image to open lightbox.</p>
            </div>
            {galleriesForFamily.map((g) => (
              <div class="p-5 border-b border-slate-100 last:border-0">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="text-sm font-bold text-slate-900">{g.label} — {g.effective.length} of {g.count} relevant</h3>
                  <a href={`/products/industry/${g.slug}`} class="text-xs font-semibold text-slate-600 hover:text-slate-900 border border-slate-200 rounded-full px-3 py-1 hover:border-slate-300 bg-white">View gallery &rarr;</a>
                </div>
                <p class="mt-1 text-xs text-slate-600 leading-relaxed">{g.description} {g.effective.length < g.count && `(filtered from ${g.count})`}.</p>
                <div class="mt-4">
                  <LightboxGallery
                    client:visible
                    images={g.effective.map(({ caption, originalIdx }) => ({ src: `${g.path}/${g.prefix}-${String(originalIdx + 1).padStart(2, "0")}.jpeg`, alt: `${g.label} ${originalIdx + 1}`, caption }))}
                  />
                </div>
              </div>
            ))}
          </section>
        )}

        <!-- Applications -->
        {appImages.length > 0 && (
          <section class="border border-slate-200 rounded-2xl p-5 bg-white">
            <h2 class="text-xs font-semibold tracking-widest uppercase text-slate-900 flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-slate-900"></span> Key applications</h2>
            <p class="text-xs text-slate-600 mt-1">Finished products made with these tools — {appImages.length} application{appImages.length > 1 ? "s" : ""}.</p>
            <div class="mt-4">
              <LightboxGallery client:visible images={appImages.map((app) => ({ src: app.src, alt: app.title, caption: `${app.code} — ${app.title} (${app.sectorName})` }))} cols="grid-cols-2 sm:grid-cols-4 gap-2.5" />
            </div>
          </section>
        )}

        <!-- Prev/next -->
        <div class="flex items-center justify-between gap-4 pt-2">
          {prev ? <a href={`/products/family/${prev.id}`} class="text-sm font-semibold border border-slate-200 rounded-xl px-4 py-2 hover:bg-slate-50">← {prev.label}</a> : <span />}
          {next ? <a href={`/products/family/${next.id}`} class="text-sm font-semibold bg-slate-900 text-white rounded-xl px-4 py-2 hover:bg-slate-800">{next.label} →</a> : <span />}
        </div>
      </div>
    </div>
  </main>
  <Footer client:idle />
</Layout>
