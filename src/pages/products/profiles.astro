---
import Layout from "../../layouts/Layout.astro";
import { BusinessHeader } from "../../components/BusinessHeader";
import { Footer } from "../../components/Footer";
import { WHEEL_PROFILES } from "../../data/wheelProfiles";
import { TOOL_FAMILIES } from "../../data/productFamilies";
---

<Layout title="ISO Wheel Profiles | KAYES" description="ISO wheel profiles 6A2, 11A2, 9A3, 1FF1 etc. with dimensions and applications.">
  <BusinessHeader client:load />
  <main class="flex-grow bg-white">
    <div class="border-b border-slate-200 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <nav class="text-xs text-slate-500 flex items-center gap-1.5">
          <a href="/products" class="hover:text-slate-900">Products</a>
          <span>/</span>
          <span class="font-semibold text-slate-900">ISO Profiles</span>
        </nav>
        <h1 class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 font-brand">ISO Wheel Profiles Directory</h1>
        <p class="mt-2 text-sm text-slate-600 max-w-3xl">Engineering profile drawings with dimensional table (D, H, W, X, T, R). Dimensions from ISO 6104 and stock tables.</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <a href="/products" class="text-xs font-semibold text-slate-900 hover:underline">← Back to products</a>
          {TOOL_FAMILIES.map((f) => (
            <a href={`/products/family/${f.id}`} class="text-xs font-medium text-slate-700 hover:text-slate-900 border border-slate-200 rounded-full px-2.5 py-1 bg-white">{f.label}</a>
          ))}
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {WHEEL_PROFILES.map((w) => (
          <div class="border border-slate-200 rounded-2xl p-4 bg-white hover:border-slate-300">
            <div class="flex items-baseline justify-between gap-2">
              <div class="text-sm font-mono font-bold text-slate-900">{w.code}</div>
              <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full border bg-slate-50 border-slate-200 text-slate-600">{w.category}</span>
            </div>
            <div class="text-sm font-semibold text-slate-800 mt-1">{w.name}</div>
            <p class="text-xs text-slate-600 mt-1 line-clamp-2">{w.description}</p>
            <div class="mt-2 flex flex-wrap gap-1">
              {w.keyDimensions.map((d) => (
                <span class="text-[10px] font-mono bg-slate-50 border border-slate-200 rounded-full px-1.5 py-0.5">{d}</span>
              ))}
            </div>
            <div class="mt-2 text-[11px] text-slate-500">Bond: {w.typicalBond}</div>
            {w.primaryUses.length > 0 && <div class="mt-1 text-[11px] text-slate-500 truncate">Uses: {w.primaryUses.join(" · ")}</div>}
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer client:idle />
</Layout>
